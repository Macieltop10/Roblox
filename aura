local function getEggPosition(egg)
    local base = egg:FindFirstChild("EggBase", true)
    if base and base:IsA("BasePart") then return base.Position end
    local sphere = egg:FindFirstChildWhichIsA("MeshPart", true)
    if sphere then return sphere.Position end
    local handle = egg:FindFirstChild("Handle")
    if handle then return handle.Position end
    if egg.PrimaryPart then return egg.PrimaryPart.Position end
    return nil
end

local function teleportTo(position, salvar)
    if not position then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if salvar then 
        posicaoSalva = root.CFrame
    end
    
    root.CFrame = CFrame.new(position + Vector3.new(0, 5, 0))
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

