    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 44, 0, 22); btn.Position = UDim2.new(1, -54, 0.5, -11)
    btn.BackgroundColor3 = estado and Color3.fromRGB(120, 80, 200) or Color3.fromRGB(50, 50, 65)
