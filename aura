local function limparScroll(scroll)
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
end

local function popularOvos()
    limparScroll(ScrollOvos)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return end
    
    local ovos = {}
    for _, egg in ipairs(renderedEggs:GetChildren()) do
        if egg:IsA("Model") then
            local pos = getEggPosition(egg)
            if pos then
                local val = getEggValue(egg.Name)
                local dist = (root.Position - pos).Magnitude
                local mostrar = true
                if ocultarComuns and val < ocultarAbaixoDe then mostrar = false end
                if dist > maxDistance then mostrar = false end
                if mostrar then
                    table.insert(ovos, {nome=egg.Name, valor=val, posicao=pos, distancia=dist, cor=getEggRarity(egg.Name)})
                end
            end
        end
    end
    if ordenarPorValor then
        table.sort(ovos, function(a,b) return a.valor > b.valor end)
    else
        table.sort(ovos, function(a,b) return a.distancia < b.distancia end)
    end
    
    for _, ovo in ipairs(ovos) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -4, 0, 32)
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 33)
        btn.Text = string.format("%s  •  %s  •  %dm", ovo.nome, formatLuck(ovo.valor), math.floor(ovo.distancia))
        btn.TextColor3 = ovo.cor
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = ScrollOvos
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
        local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0, 8); p.Parent = btn
        btn.MouseButton1Click:Connect(function()
            teleportTo(ovo.posicao, true)
        end)
    end
end

local function popularJogadores()
    limparScroll(ScrollJog)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local lista = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pchar = p.Character
            if pchar then
                local pr = pchar:FindFirstChild("HumanoidRootPart")
                if pr then
                    table.insert(lista, {nome=p.Name, posicao=pr.Position, distancia=(root.Position - pr.Position).Magnitude})
                end
            end
        end
    end
    
    table.sort(lista, function(a,b) return a.distancia < b.distancia end)
    
    for _, j in ipairs(lista) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -4, 0, 32)
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 33)
        btn.Text = string.format("%s  •  %dm", j.nome, math.floor(j.distancia))
        btn.TextColor3 = Color3.fromRGB(0, 220, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = ScrollJog
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = btn
        local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0, 8); p.Parent = btn
        btn.MouseButton1Click:Connect(function()
            teleportTo(j.posicao, true)
        end)
    end
end

