local function createEggESP(egg)
    local handle = egg:FindFirstChild("Handle")
    if not handle then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TKI_EggESP"
    billboard.Size = UDim2.new(0, 220, 0, 20)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = handle
    billboard.Parent = handle
    
    local info = Instance.new("TextLabel")
    info.Name = "Info"
    info.Size = UDim2.new(1, 0, 1, 0)
    info.BackgroundTransparency = 1
    info.TextColor3 = Color3.fromRGB(255, 255, 255)
    info.TextStrokeTransparency = 0.2
    info.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    info.Font = Enum.Font.GothamBold
    info.TextSize = 13
    info.Text = ""
    info.Parent = billboard
end

local function updateEggESP()
    if not espEnabled then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local renderedEggs = workspace:FindFirstChild("RenderedEggs")
    if not renderedEggs then return end
    
    for _, egg in ipairs(renderedEggs:GetChildren()) do
        if egg:IsA("Model") then
            local handle = egg:FindFirstChild("Handle")
            if handle then
                local eggVal = getEggValue(egg.Name)
                local mostrar = true
                if ocultarComuns and eggVal < ocultarAbaixoDe then 
                    mostrar = false 
                end
                
                if mostrar then
                    local bb = handle:FindFirstChild("TKI_EggESP")
                    if not bb then
                        createEggESP(egg)
                        bb = handle:FindFirstChild("TKI_EggESP")
                    end
                    if bb then
                        local dist = (root.Position - handle.Position).Magnitude
                        if dist <= maxDistance then
                            bb.Enabled = true
                            local info = bb:FindFirstChild("Info")
                            if info then
                                info.Text = string.format("%s  •  %s  •  %dm", egg.Name, formatLuck(eggVal), math.floor(dist))
                                info.TextColor3 = getEggRarity(egg.Name)
                            end
                        else
                            bb.Enabled = false
                        end
                    end
                else
                    local bb = handle:FindFirstChild("TKI_EggESP")
                    if bb then bb:Destroy() end
                end
            end
        end
    end
end

