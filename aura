    ["Slime Egg"] = 1000,
    ["Ice Egg"] = 3000,
    
    -- Legendary
    ["Glass Egg"] = 10000,
    ["Golden Egg"] = 30000,
    
    -- Mythic
    ["Crystal Egg"] = 150000,
    ["Skull Egg"] = 250000,
    ["Dominus Egg"] = 700000,
    ["Flaming Egg"] = 1000000,
    ["Sinister Egg"] = 3000000,
    ["Soul Egg"] = 7000000,
    ["Tidal Egg"] = 7000000,
    ["Bloom Egg"] = 2000000000,
    
    -- Divine
    ["Aurora Egg"] = 300000000,
    ["Galaxy Egg"] = 1500000000,
    ["Solaris Egg"] = 500000000000,
    
    -- Ethereal
    ["Blackhole Egg"] = 100000000000,
    ["Cherub Egg"] = 1000000000000,
}

local function getEggValue(nome)
    return EggLuckMap[nome] or 999999999
end

local function formatLuck(n)
    if n >= 1e12 then return string.format("%.1fT", n/1e12) end
    if n >= 1e9 then return string.format("%.1fB", n/1e9) end
    if n >= 1e6 then return string.format("%.1fM", n/1e6) end
    if n >= 1e3 then return string.format("%.1fK", n/1e3) end
    return tostring(n)
end

local function getEggRarity(name)
    local val = getEggValue(name)
    if val >= 1e12 then return Color3.fromRGB(255, 0, 255)
    elseif val >= 1e9 then return Color3.fromRGB(255, 50, 50)
    elseif val >= 1e6 then return Color3.fromRGB(255, 200, 0)
    elseif val >= 1e3 then return Color3.fromRGB(180, 0, 255)
    elseif val >= 500 then return Color3.fromRGB(0, 150, 255)
    elseif val >= 30 then return Color3.fromRGB(0, 255, 0)
    end
    return Color3.fromRGB(180, 180, 180)
end

