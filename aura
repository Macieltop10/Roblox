local function criarSlider(parent, icone, texto, min, max, padrao, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 60)
    row.BackgroundColor3 = Color3.fromRGB(25, 25, 33)
    row.BorderSizePixel = 0
    row.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = row
    
    local ic = Instance.new("TextLabel")
    ic.Size = UDim2.new(0, 30, 0, 30); ic.Position = UDim2.new(0, 8, 0, 4)
    ic.BackgroundTransparency = 1; ic.Text = icone
    ic.TextColor3 = Color3.fromRGB(170, 120, 255)
    ic.Font = Enum.Font.GothamBold; ic.TextSize = 18; ic.Parent = row
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -120, 0, 30); lbl.Position = UDim2.new(0, 40, 0, 4)
    lbl.BackgroundTransparency = 1; lbl.Text = texto .. ": " .. padrao
    lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    lbl.Font = Enum.Font.Gotham; lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = row
    
    local barra = Instance.new("Frame")
    barra.Size = UDim2.new(1, -60, 0, 6); barra.Position = UDim2.new(0, 40, 0, 44)
    barra.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    barra.BorderSizePixel = 0; barra.Parent = row
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1, 0); bc.Parent = barra
    
    local preench = Instance.new("Frame")
    preench.Size = UDim2.new((padrao - min) / (max - min), 0, 1, 0)
    preench.BackgroundColor3 = Color3.fromRGB(120, 80, 200)
    preench.BorderSizePixel = 0; preench.Parent = barra
    local pc = Instance.new("UICorner"); pc.CornerRadius = UDim.new(1, 0); pc.Parent = preench
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1
    btn.Text = ""; btn.Parent = barra
    
    local arrastando = false
    local function atualizar(x)
        local rel = math.clamp((x - barra.AbsolutePosition.X) / barra.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel)
        preench.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = texto .. ": " .. val
        callback(val)
    end
    
    btn.MouseButton1Down:Connect(function()
        arrastando = true
        atualizar(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if arrastando and input.UserInputType == Enum.UserInputType.MouseMovement then
            atualizar(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            arrastando = false
        end
    end)
end

